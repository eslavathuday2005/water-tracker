# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a MongoDB connection string (e.g., local MongoDB or MongoDB Atlas)
# If left empty, the server automatically starts an in-memory MongoDB instance for zero-configuration testing.
MONGO_URI=mongodb://localhost:27017/water_tracker

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Default System Hydration Goal (in ml)
DEFAULT_DAILY_GOAL=2000

# Initial Admin Credentials (seeded automatically if not present)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@watertracker.com
ADMIN_PASSWORD=Admin@12345
